# Python environments and package artifacts
.venv/
.mamba/
env/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
dist-ci/

# Tests, coverage, and tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Local configuration and secrets
.env
.env.*
