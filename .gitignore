!configs/runs/*.yaml
outputs/
work/
*.partial
*.tmp

# Large local input data. Small, intentional test data belongs under fixtures/.
data/
*.fastq
*.fastq.gz
*.fq
*.fq.gz
!fixtures/**/*.fastq
!fixtures/**/*.fastq.gz
!fixtures/**/*.fq
!fixtures/**/*.fq.gz
!src/nanopore3/example_data/*.fastq

